# Application
APP_NAME=CloudGaming
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+asyncpg://cloudgaming:cloudgaming@localhost:5432/cloudgaming

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Streaming
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=
MAX_BITRATE=6000
DEFAULT_RESOLUTION=1080p
DEFAULT_FPS=60

# Docker
DOCKER_NETWORK=cloud-gaming-net
GAME_CONTAINER_CPU_LIMIT=4.0
GAME_CONTAINER_MEMORY_LIMIT=8g
GAME_CONTAINER_IMAGE=cloud-gaming/game-node:latest

# GPU
GPU_ENABLED=false
GPU_DRIVER=nvidia

# Session
MAX_SESSIONS_PER_USER=1
SESSION_TIMEOUT_MINUTES=120
IDLE_TIMEOUT_MINUTES=15

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
